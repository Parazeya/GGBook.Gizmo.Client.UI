@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

@if (Product != null)
{
    <div class="gg-hover-info">

        <div class="gg-hover-info__header">
            <HexagonIcon />
            @LocalizationService.GetString("GIZ_SHOP_CARD_TIME_PRODUCT_DESCRIPTION")
        </div>

        <div class="gg-hover-info__time">
            <Icon SVGIcon="Icons.Time_Client" Size="IconSizes.Small" />
            @GetTimeText()
        </div>

        <div class="gg-hover-info__row">
            <span class="gg-hover-info__label">@LocalizationService.GetString("GIZ_PRODUCT_TIME_EXPIRATION_BUYING_TIME")</span>
            <span class="gg-hover-info__value">
                @if (Product.PurchaseAvailability != null)
                {
                    @ProductHelpers.GetPurchaseAvailabilities(Product, true, LocalizationService).FirstOrDefault()
                }
                else
                {
                    <Icon SVGIcon="Icons.Infinite" Size="IconSizes.Small" />
                }
            </span>
        </div>

        @if (Product.ProductType == ProductType.ProductTime && Product.TimeProduct != null)
        {
            <div class="gg-hover-info__row">
                <span class="gg-hover-info__label">@LocalizationService.GetString("GIZ_PRODUCT_TIME_EXPIRATION_ACTION_TIME")</span>
                <span class="gg-hover-info__value">
                    @if (Product.TimeProduct.UsageAvailability != null)
                    {
                        @ProductHelpers.GetUsageAvailabilities(Product, true, LocalizationService).FirstOrDefault()
                    }
                    else
                    {
                        <Icon SVGIcon="Icons.Infinite" Size="IconSizes.Small" />
                    }
                </span>
            </div>

            @if (Product.TimeProduct.ExpirationOptions != ProductTimeExpirationOptionType.None)
            {
                <div class="gg-hover-info__row">
                    <span class="gg-hover-info__label">@LocalizationService.GetString("GIZ_PRODUCT_TIME_EXPIRES")</span>
                    <span class="gg-hover-info__value">
                        <span class="gg-hover-info__expiry-list">
                            @if (Product.TimeProduct.ExpirationOptions.HasFlag(ProductTimeExpirationOptionType.ExpireAtDayTime))
                            {
                                <span class="gg-hover-info__expiry-tag">@ProductHelpers.GetDayTimeFromMinute(Product.TimeProduct.ExpireAtDayTimeMinute)</span>
                            }
                            @if (Product.TimeProduct.ExpirationOptions.HasFlag(ProductTimeExpirationOptionType.ExpireAfterTime))
                            {
                                <span class="gg-hover-info__expiry-tag">@ProductHelpers.GetExpiresAfterText(Product.TimeProduct, LocalizationService)</span>
                            }
                            @if (Product.TimeProduct.ExpirationOptions.HasFlag(ProductTimeExpirationOptionType.ExpiresAtLogout))
                            {
                                <span class="gg-hover-info__expiry-tag">@LocalizationService.GetString("GIZ_PRODUCT_TIME_EXPIRATION_AFTER_LOGOUT")</span>
                            }
                        </span>
                    </span>
                </div>
            }
        }

    </div>
}
