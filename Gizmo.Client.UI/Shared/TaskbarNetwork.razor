@namespace Gizmo.Client.UI.Shared
@inherits ComponentBase
@implements IDisposable
@inject INetworkStatusService NetworkService

@if (_open)
{
    <div class="tb-overlay" @onclick="Close"></div>
    <div class="tb-popup tb-popup--right">
        <div class="tb-popup__header">
            <span>Сеть</span>
            <button class="tb-close-btn" @onclick="Close">✕</button>
        </div>
        <div class="tb-popup__section" style="gap:0.6rem;display:flex;flex-direction:column;">
            <div style="display:flex;align-items:center;gap:1rem;">
                <span style="font-size:2.4rem;">@TypeEmoji()</span>
                <div>
                    <div style="font-size:1.3rem;font-weight:700;color:@(NetworkService.IsConnected ? "var(--gg-accent)" : "#e05c5c");">
                        @(NetworkService.IsConnected ? TypeLabel() : "Нет подключения")
                    </div>
                    @if (NetworkService.IpAddress is not null)
                    {
                        <div style="font-size:1.1rem;color:rgba(255,255,255,0.45);margin-top:0.2rem;">@NetworkService.IpAddress</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<button class="tb-icon-btn @(_open ? "tb-icon-btn--active" : "") @(!NetworkService.IsConnected ? "tb-icon-btn--warn" : "")"
        @onclick="Toggle" title="@(NetworkService.IpAddress ?? "Нет сети")">
    <svg viewBox="0 0 24 24" fill="currentColor">
        @if (!NetworkService.IsConnected)
        {
            <path d="M23.64 7c-.45-.34-4.93-4-11.64-4-1.5 0-2.89.19-4.15.48L18.18 13.8 23.64 7zm-6.6 8.22L3.27 1.44 2 2.72l2.05 2.06C1.91 5.76.59 6.83 0 7l11.99 15 3.91-4.92 2.02 2.02 1.28-1.28-2.16-2.6z"/>
        }
        else if (NetworkService.ConnectionType == NetworkConnectionType.WiFi)
        {
            <path d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z"/>
        }
        else
        {
            <path d="M17 7H7C4.24 7 2 9.24 2 12s2.24 5 5 5h10c2.76 0 5-2.24 5-5s-2.24-5-5-5zm0 8H7c-1.66 0-3-1.34-3-3s1.34-3 3-3h10c1.66 0 3 1.34 3 3s-1.34 3-3 3zm-1-3c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2z"/>
        }
    </svg>
</button>

@code {
    private bool _open;

    protected override void OnInitialized() =>
        NetworkService.StatusChanged += OnStatusChanged;

    private async void OnStatusChanged(object? s, EventArgs e) =>
        await InvokeAsync(StateHasChanged);

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private string TypeEmoji() => NetworkService.ConnectionType switch
    {
        NetworkConnectionType.WiFi => "📶",
        NetworkConnectionType.Ethernet => "🔌",
        _ => "❌",
    };

    private string TypeLabel() => NetworkService.ConnectionType switch
    {
        NetworkConnectionType.WiFi => "Wi-Fi",
        NetworkConnectionType.Ethernet => "Ethernet",
        _ => "Подключено",
    };

    public void Dispose() =>
        NetworkService.StatusChanged -= OnStatusChanged;
}
