@namespace Gizmo.Client.UI.Pages
@inherits ComponentBase

<style>
    @@keyframes gg-spin { to { transform: rotate(360deg); } }
    .gg-spinner {
        width: 3.2rem; height: 3.2rem;
        border: 0.35rem solid rgba(255,255,255,0.1);
        border-top-color: #4ecdc4;
        border-radius: 50%;
        animation: gg-spin 0.7s linear infinite;
    }

    /* ── Case list card ── */
    .gg-case-card { transition: transform 0.15s ease, box-shadow 0.15s ease; cursor: pointer; }
    .gg-case-card:hover { transform: scale(1.03); box-shadow: 0 1.2rem 3rem rgba(0,0,0,0.6); }
    .gg-case-card:active { transform: scale(0.97); }

    /* ── History item ── */
    .gg-hist-item { transition: background 0.12s; cursor: pointer; }
    .gg-hist-item:hover { background: rgba(255,255,255,0.07) !important; }

    /* ── Glassmorphism panel ── */
    .gg-glass { background: rgba(6,9,14,0.7); backdrop-filter: blur(2rem); -webkit-backdrop-filter: blur(2rem); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.09), 0 0.4rem 2rem rgba(0,0,0,0.4); border-radius: 1.4rem; }

    /* ── Roulette ── */
    .gg-roulette-item {
        flex-shrink: 0; width: 11rem; height: 11rem;
        border-radius: 0.6rem;
        background: rgba(8,11,18,0.98);
        position: relative; overflow: hidden;
        display: flex; align-items: center; justify-content: center;
        user-select: none;
        border: 1px solid rgba(255,255,255,0.08);
        contain: layout paint style;
    }
    .gg-roulette-item-img { position:absolute;inset:0;width:100%;height:100%;object-fit:cover; }
    .gg-roulette-item-icon { display:flex;align-items:center;justify-content:center;position:absolute;inset:0; }

    /* ── Reward card (matches mobile .rcard) ── */
    .gg-rcard {
        position: relative; overflow: hidden;
        border-radius: 1.2rem;
        aspect-ratio: 1;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        cursor: pointer;
        transition: transform 0.15s;
    }
    .gg-rcard:active { transform: scale(0.93); }
    .gg-rcard-img { width:100%;height:100%;object-fit:cover;display:block; }
    .gg-rcard-icon { width:100%;height:100%;display:flex;align-items:center;justify-content:center; }
    .gg-rcard-chance {
        position:absolute;top:0.5rem;right:0.5rem;
        background:rgba(0,0,0,0.65);backdrop-filter:blur(0.4rem);
        color:#fff;font-size:1.2rem;font-weight:700;
        padding:0.3rem 0.7rem;border-radius:0.6rem;line-height:1.4;
    }
    .gg-rcard-name-bar {
        position:absolute;bottom:0;left:0;right:0;
        padding:2.2rem 0.7rem 0.7rem;
        background:linear-gradient(to top,rgba(0,0,0,0.85) 0%,transparent 100%);
    }
    .gg-rcard-name {
        display:block;color:#fff;font-size:1.2rem;font-weight:700;
        text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    }

    /* ── Out-of-stock reward card ── */
    .gg-rcard--oos { opacity: 0.45; }
    .gg-rcard-oos { position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.35);z-index:2; }

    /* ── Case alert panel ── */
    .gg-case-alert { display:flex;flex-direction:column;gap:0.8rem;padding:1.2rem 1.4rem;border-radius:1rem;background:rgba(224,92,92,0.1);border:1px solid rgba(224,92,92,0.25); }
    .gg-case-alert--info { background:rgba(78,205,196,0.08);border-color:rgba(78,205,196,0.2); }

    /* ── Misc ── */
    .gg-key-bar { display:flex;align-items:center;justify-content:space-between;padding:1rem 1.4rem;border-radius:1rem;background:rgba(6,9,14,0.75);border:1px solid rgba(255,255,255,0.09); }
    @@keyframes gg-reveal { from { transform: scale(0.55) translateY(2.4rem); opacity: 0; } to { transform: scale(1) translateY(0); opacity: 1; } }
    .gg-reveal { animation: gg-reveal 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
    @@keyframes gg-ring-spin { to { transform: rotate(360deg); } }
    .gg-ring-spin { animation: gg-ring-spin 3s linear infinite; }
    @@keyframes gg-pulse { 0%,100% { opacity:0.7; } 50% { opacity:1; } }
    .gg-win-line { animation: gg-pulse 1.8s ease-in-out infinite; }
    @@keyframes gg-spin { to { transform: rotate(360deg); } }
    .gg-spinner { width:3.2rem;height:3.2rem;border:0.35rem solid rgba(255,255,255,0.1);border-top-color:#4ecdc4;border-radius:50%;animation:gg-spin 0.7s linear infinite; }

    /* ── Case action row buttons ── */
    .gg-open-btn {
        display: flex; align-items: center; justify-content: center; gap: 0.6rem;
        width: auto; min-width: 19rem; padding: 1.1rem 2.4rem;
        background: linear-gradient(135deg, #4ecdc4 0%, #2ab7ae 100%);
        color: #0a0e16; font-size: 1.55rem; font-weight: 700;
        border: none; border-radius: 1rem; cursor: pointer;
        box-shadow: 0 0.4rem 1.6rem rgba(78,205,196,0.35);
        transition: filter 0.15s, transform 0.12s, box-shadow 0.15s;
    }
    .gg-open-btn:hover:not(:disabled) { filter: brightness(1.1); box-shadow: 0 0.6rem 2rem rgba(78,205,196,0.5); transform: translateY(-1px); }
    .gg-open-btn:active:not(:disabled) { transform: translateY(0) scale(0.97); }
    .gg-open-btn--loading { opacity: 0.75; cursor: not-allowed; }
    .gg-open-btn--disabled {
        background: rgba(255,255,255,0.07) !important;
        color: rgba(255,255,255,0.28) !important;
        box-shadow: none !important; cursor: not-allowed;
    }
    .gg-open-btn--buy {
        background: rgba(78,205,196,0.12) !important;
        color: #4ecdc4 !important;
        border: 1px solid rgba(78,205,196,0.3) !important;
        box-shadow: none !important;
    }
    .gg-open-btn--buy:hover { background: rgba(78,205,196,0.2) !important; box-shadow: 0 0.3rem 1rem rgba(78,205,196,0.2) !important; }

    .gg-add-key-btn {
        display: flex; align-items: center; justify-content: center;
        padding: 0.9rem 1.4rem; flex-shrink: 0;
        background: rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.78); font-size: 1.2rem; font-weight: 600;
        border: 1px solid rgba(255,255,255,0.16); border-radius: 1rem; cursor: pointer;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
        white-space: nowrap;
    }
    .gg-add-key-btn:hover { background: rgba(78,205,196,0.15); color: #4ecdc4; border-color: rgba(78,205,196,0.4); }
</style>

@if (!GGModConfig.IsResolved)
{
    <div style="display:flex;justify-content:center;padding:6rem 0;">
        <div class="gg-spinner"></div>
    </div>
}
else if (GGModConfig.Cases)
{
<div style="height:100%;display:flex;overflow:hidden;">

    <!-- MAIN CONTENT PANEL -->
    <div style="flex:1;min-width:0;display:flex;flex-direction:column;overflow:hidden;background:rgba(6,9,14,0.55);backdrop-filter:blur(0.5rem);">

        @if (_selectedCase is null)
        {
            <!-- LIST VIEW -->
            <div style="height:100%;overflow-y:auto;padding:2rem 2.4rem;" class="giz-scrollbar--v">
                <span style="display:block;font-size:2.6rem;font-weight:700;color:#FAFAFA;font-family:Rubik,sans-serif;letter-spacing:0.04em;margin-bottom:2rem;text-shadow:0 2px 12px rgba(0,0,0,0.8);">@GGModL10n.Get(GGModL10n.CasesTitle)</span>

                @if (_casesLoading)
                {
                    <div style="display:flex;align-items:center;justify-content:center;height:16rem;">
                        <div class="gg-spinner"></div>
                    </div>
                }
                else if (_casesError is not null)
                {
                    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.2rem;height:16rem;color:#e05c5c;font-size:1.3rem;text-align:center;padding:2rem;">
                        <Icon SVGIcon="Icons.Info_Client" Size="IconSizes.Large" Style="color:#e05c5c;opacity:0.7;" />
                        <span>@_casesError</span>
                        <Button Variant="ButtonVariants.Outline" Size="ButtonSizes.Small" Text="@GGModL10n.Get(GGModL10n.Retry)" @onclick="LoadCasesAsync" />
                    </div>
                }
                else if (_cases.Count == 0)
                {
                    <div style="display:flex;align-items:center;justify-content:center;height:16rem;color:#3a4455;font-size:1.3rem;text-align:center;padding:2rem;">
                        @GGModL10n.Get(GGModL10n.NoCases)
                    </div>
                }
                else
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(24rem,1fr));gap:1.8rem;">
                        @foreach (var c in _cases)
                        {
                            <div class="gg-case-card"
                                 @onclick="() => SelectCaseAsync(c)"
                                 style="position:relative;border-radius:1.4rem;overflow:hidden;aspect-ratio:1;background:rgba(10,14,20,0.85);border:1px solid rgba(255,255,255,0.12);">

                                @if (!string.IsNullOrEmpty(c.PictureUrl))
                                {
                                    <img src="@c.PictureUrl" alt="@c.Name"
                                         style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;"
                                         onerror="this.style.display='none'" />
                                }
                                else
                                {
                                    <div style="position:absolute;inset:0;background:linear-gradient(145deg,#1a1f2e,#0d1018);display:flex;align-items:center;justify-content:center;">
                                        <Icon SVGIcon="Icons.Star_Client" Size="IconSizes.Large" Style="color:rgba(255,255,255,0.15);width:6rem;height:6rem;" />
                                    </div>
                                }

                                <div style="position:absolute;bottom:0;left:0;right:0;padding:5rem 1.4rem 1.4rem;background:linear-gradient(to top,rgba(0,0,0,0.97) 0%,rgba(0,0,0,0.6) 60%,transparent 100%);">
                                    <span style="display:block;font-size:1.6rem;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:0.06em;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@c.Name</span>
                                </div>

                                @if (c.PointsPrice > 0)
                                {
                                    <div style="position:absolute;top:0.8rem;left:0.8rem;display:flex;align-items:center;gap:0.5rem;padding:0.45rem 1rem;border-radius:2rem;background:rgba(0,0,0,0.85);border:1px solid rgba(240,192,64,0.4);">
                                        <Icon SVGIcon="Icons.Star_Client" Size="IconSizes.Small" Style="color:#F0C040;" />
                                        <span style="font-size:1.4rem;font-weight:700;color:#F0C040;">@c.PointsPrice</span>
                                    </div>
                                }

                                <div style="position:absolute;top:0.8rem;right:0.8rem;display:flex;align-items:center;gap:0.5rem;padding:0.45rem 1rem;border-radius:2rem;background:rgba(0,0,0,0.85);border:1px solid @(c.AvailableKeys > 0 ? "rgba(78,205,196,0.4)" : "rgba(255,255,255,0.1)");">
                                    <Icon SVGIcon="Icons.Key" Size="IconSizes.Small" Style="@($"color:{(c.AvailableKeys > 0 ? "#4ecdc4" : "#555")};")" />
                                    <span style="font-size:1.2rem;font-weight:700;color:@(c.AvailableKeys > 0 ? "#4ecdc4" : "#555");">@c.AvailableKeys</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <!-- CASE DETAIL -->
            <div style="display:flex;align-items:center;gap:1.2rem;padding:1.4rem 2rem;border-bottom:1px solid rgba(255,255,255,0.08);flex-shrink:0;">
                <IconButton SVGIcon="Icons.ArrowBack_Client" Variant="ButtonVariants.Text" @onclick="Back" />
                <span style="font-size:1.8rem;font-weight:700;color:#FAFAFA;font-family:Rubik,sans-serif;text-shadow:0 2px 8px rgba(0,0,0,0.8);">@_selectedCase.Name</span>
            </div>

            @if (_detailLoading)
            {
                <div style="flex:1;display:flex;align-items:center;justify-content:center;">
                    <div class="gg-spinner"></div>
                </div>
            }
            else if (_detailError is not null)
            {
                <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.2rem;color:#e05c5c;font-size:1.3rem;text-align:center;padding:2rem;">
                    <Icon SVGIcon="Icons.Info_Client" Size="IconSizes.Large" Style="color:#e05c5c;opacity:0.7;" />
                    <span>@_detailError</span>
                    <Button Variant="ButtonVariants.Outline" Size="ButtonSizes.Small" Text="@GGModL10n.Get(GGModL10n.Retry)" @onclick="() => LoadCaseDetailAsync(_selectedCase.Id)" />
                </div>
            }
            else
            {
                <div style="flex:1;overflow-y:auto;padding:1.8rem 2rem;display:flex;flex-direction:column;gap:1.2rem;min-height:0;" class="giz-scrollbar--v">

                    <!-- ROULETTE STRIP -->
                    <div style="max-width:70rem;margin:0 auto;position:relative;overflow:hidden;border-radius:1.2rem;background:#080b12;box-shadow:inset 0 2px 16px rgba(0,0,0,0.8),0 0 0 1px rgba(255,255,255,0.07);">
                        <!-- Vertical vignette darkens top/bottom edges -->
                        <div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(8,11,18,0.4) 0%,transparent 20%,transparent 80%,rgba(8,11,18,0.4) 100%);z-index:1;pointer-events:none;"></div>
                        <!-- Side edge fades -->
                        <div style="position:absolute;left:0;top:0;bottom:0;width:13rem;background:linear-gradient(to right,#080b12 40%,transparent 100%);z-index:2;pointer-events:none;"></div>
                        <div style="position:absolute;right:0;top:0;bottom:0;width:13rem;background:linear-gradient(to left,#080b12 40%,transparent 100%);z-index:2;pointer-events:none;"></div>
                        <!-- Win arrows -->
                        <div class="gg-win-line" style="position:absolute;left:50%;top:0;transform:translateX(-50%);width:0;height:0;border-left:1.1rem solid transparent;border-right:1.1rem solid transparent;border-top:1.4rem solid #4ecdc4;z-index:5;filter:drop-shadow(0 0 6px #4ecdc4);pointer-events:none;"></div>
                        <div class="gg-win-line" style="position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:0;height:0;border-left:1.1rem solid transparent;border-right:1.1rem solid transparent;border-bottom:1.4rem solid #4ecdc4;z-index:5;filter:drop-shadow(0 0 6px #4ecdc4);pointer-events:none;"></div>
                        <!-- Scrolling strip -->
                        <div id="giz-roulette-vp" style="height:11rem;overflow:hidden;width:100%;">
                            <div style="display:flex;align-items:center;gap:0.3rem;padding:1rem;will-change:transform;backface-visibility:hidden;transform:@_rouletteTransform;transition:@_rouletteTransition;">
                                @foreach (var item in _wheelItems)
                                {
                                    <div class="gg-roulette-item" style="border-bottom:3px solid @item.Color;">
                                        @if (!string.IsNullOrEmpty(item.PictureUrl))
                                        {
                                            <img src="@item.PictureUrl" alt="@item.Name" class="gg-roulette-item-img" onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <div class="gg-roulette-item-icon">
                                                <Icon SVGIcon="@GetRewardIcon(item.RewardType)" Size="IconSizes.Large" Style="@($"color:{item.Color};")" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- SPIN ERROR -->
                    @if (_spinError is not null)
                    {
                        <div style="display:flex;align-items:center;gap:0.8rem;padding:0.9rem 1.2rem;border-radius:0.8rem;background:rgba(224,92,92,0.12);border:1px solid rgba(224,92,92,0.3);">
                            <Icon SVGIcon="Icons.Info_Client" Size="IconSizes.Small" Style="color:#e05c5c;flex-shrink:0;" />
                            <span style="font-size:1.2rem;color:#e05c5c;">@_spinError</span>
                        </div>
                    }

                    <!-- CASE ALERT PANEL -->
                    @if (!_selectedCase.AvailableToOpen)
                    {
                        <div class="gg-case-alert">
                            <div style="display:flex;align-items:center;gap:0.8rem;">
                                <Icon SVGIcon="Icons.Info_Client" Size="IconSizes.Small" Style="color:#e05c5c;flex-shrink:0;" />
                                <span style="font-size:1.25rem;font-weight:700;color:#e05c5c;">@GGModL10n.Get(GGModL10n.CaseUnavailableTitle)</span>
                            </div>
                            <span style="font-size:1.15rem;color:rgba(255,255,255,0.5);padding-left:2.8rem;">@GGModL10n.Get(GGModL10n.CaseLimitedExhausted)</span>
                        </div>
                    }
                    else if (_availableKeys == 0 && _selectedCase.PaymentType == 0)
                    {
                        <div class="gg-case-alert gg-case-alert--info">
                            <div style="display:flex;align-items:center;gap:0.8rem;">
                                <Icon SVGIcon="Icons.Key" Size="IconSizes.Small" Style="color:#4ecdc4;flex-shrink:0;" />
                                <span style="font-size:1.25rem;font-weight:700;color:#4ecdc4;">@GGModL10n.Get(GGModL10n.NoKeysTitle)</span>
                            </div>
                            @if (_selectedCase.CanGetViaTask)
                            {
                                <div style="display:flex;align-items:center;gap:0.7rem;padding-left:2.8rem;">
                                    <Icon SVGIcon="Icons.Star_Client" Size="IconSizes.Small" Style="color:rgba(255,255,255,0.4);flex-shrink:0;" />
                                    <span style="font-size:1.15rem;color:rgba(255,255,255,0.5);">@GGModL10n.Get(GGModL10n.GetViaTasksHint)</span>
                                </div>
                            }
                            @if (_selectedCase.CanGetViaReferral)
                            {
                                <div style="display:flex;align-items:center;gap:0.7rem;padding-left:2.8rem;">
                                    <Icon SVGIcon="Icons.User_Client" Size="IconSizes.Small" Style="color:rgba(255,255,255,0.4);flex-shrink:0;" />
                                    <span style="font-size:1.15rem;color:rgba(255,255,255,0.5);">@GGModL10n.Get(GGModL10n.GetViaReferralHint)</span>
                                </div>
                            }
                            @if (!_selectedCase.CanGetViaTask && !_selectedCase.CanGetViaReferral)
                            {
                                <span style="font-size:1.15rem;color:rgba(255,255,255,0.5);padding-left:2.8rem;">@GGModL10n.Get(GGModL10n.NoKeysAvailable)</span>
                            }
                        </div>
                    }

                    <!-- KEY + ACTION ROW: 3-column grid — keys+buy | open button (centered) | spacer -->
                    <div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1.2rem;">

                        <!-- LEFT: key count pill + buy keys button grouped -->
                        <div style="display:flex;align-items:center;gap:0.8rem;">

                            <div style="display:flex;align-items:center;gap:0.8rem;background:@(_availableKeys > 0 ? "rgba(78,205,196,0.1)" : "rgba(255,255,255,0.07)");border:1px solid @(_availableKeys > 0 ? "rgba(78,205,196,0.3)" : "rgba(255,255,255,0.14)");border-radius:1rem;padding:0.8rem 1.4rem;flex-shrink:0;">
                                <Icon SVGIcon="Icons.Key" Size="IconSizes.Small" Style="@($"color:{(_availableKeys > 0 ? "#4ecdc4" : "rgba(255,255,255,0.38)")};")" />
                                <div style="display:flex;flex-direction:column;line-height:1.3;">
                                    <span style="font-size:1.25rem;font-weight:700;color:@(_availableKeys > 0 ? "#4ecdc4" : "rgba(255,255,255,0.52)");">@_availableKeys @KeysText(_availableKeys)</span>
                                    <span style="font-size:1rem;color:rgba(255,255,255,0.48);">@GGModL10n.Get(GGModL10n.KeysAvailableLabel)</span>
                                </div>
                            </div>

                            @if (_selectedCase.PointsPrice > 0)
                            {
                                <button class="gg-add-key-btn" @onclick="() => { _showBuyPanel = !_showBuyPanel; _buyQty = 1; }">
                                    @(_showBuyPanel ? "✕" : $"+ {GGModL10n.Get(GGModL10n.KeyFew)}")
                                </button>
                            }

                        </div>

                        <!-- CENTER: main action button (grid auto column = truly centered) -->
                        @if (_availableKeys > 0 && _selectedCase.AvailableToOpen)
                        {
                            <button class="gg-open-btn @(_isSpinning ? "gg-open-btn--loading" : "")"
                                    disabled="@_isSpinning"
                                    @onclick="SpinAsync">
                                @if (_isSpinning)
                                {
                                    <span class="gg-spinner" style="width:1.8rem;height:1.8rem;border-width:0.25rem;"></span>
                                    <span>@GGModL10n.Get(GGModL10n.Spinning)</span>
                                }
                                else
                                {
                                    <Icon SVGIcon="Icons.Key" Size="IconSizes.Small" Style="opacity:0.8;" />
                                    <span>@GGModL10n.Get(GGModL10n.OpenCase)</span>
                                }
                            </button>
                        }
                        else if (!_selectedCase.AvailableToOpen)
                        {
                            <button class="gg-open-btn gg-open-btn--disabled" disabled="true">
                                <span>@GGModL10n.Get(GGModL10n.CaseUnavailableBtn)</span>
                            </button>
                        }
                        else if (_selectedCase.PointsPrice > 0)
                        {
                            <button class="gg-open-btn gg-open-btn--buy"
                                    @onclick="() => { _showBuyPanel = !_showBuyPanel; _buyQty = 1; }">
                                <Icon SVGIcon="Icons.Key" Size="IconSizes.Small" Style="opacity:0.8;" />
                                <span>@string.Format(GGModL10n.Get(GGModL10n.BuyKeyFmt), _selectedCase.PointsPrice)</span>
                            </button>
                        }

                        <!-- RIGHT: empty spacer keeps button truly centered -->
                        <div></div>

                    </div>

                    <!-- BUY PANEL -->
                    @if (_showBuyPanel)
                    {
                        <div class="gg-glass" style="padding:1.4rem;display:flex;flex-direction:column;gap:1.2rem;">
                            <span style="font-size:1.3rem;font-weight:700;color:#FAFAFA;letter-spacing:0.04em;">@GGModL10n.Get(GGModL10n.BuyKeysTitle)</span>
                            <div style="display:flex;align-items:center;gap:1.2rem;">
                                <div style="display:flex;align-items:center;gap:0.6rem;background:rgba(0,0,0,0.4);border-radius:0.8rem;padding:0.2rem;">
                                    <button @onclick="() => { if(_buyQty>1) _buyQty--; }"
                                            style="width:3.6rem;height:3.6rem;border-radius:0.6rem;border:none;background:rgba(255,255,255,0.08);color:#FAFAFA;font-size:2rem;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1;">-</button>
                                    <span style="font-size:1.6rem;font-weight:700;color:#FAFAFA;min-width:2.4rem;text-align:center;">@_buyQty</span>
                                    <button @onclick="() => { if(_buyQty<10) _buyQty++; }"
                                            style="width:3.6rem;height:3.6rem;border-radius:0.6rem;border:none;background:rgba(255,255,255,0.08);color:#FAFAFA;font-size:2rem;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1;">+</button>
                                </div>
                                <div style="flex:1;display:flex;flex-direction:column;gap:0.2rem;">
                                    <span style="font-size:1.35rem;font-weight:700;color:#F0C040;">@(_buyQty * _selectedCase.PointsPrice) @GGModL10n.Get(GGModL10n.PointsLabel)</span>
                                    <span style="font-size:1.1rem;color:#6b7a8d;">@_buyQty x @_selectedCase.PointsPrice</span>
                                </div>
                            </div>
                            @if (_buyError is not null)
                            {
                                <span style="font-size:1.2rem;color:#e05c5c;">@_buyError</span>
                            }
                            <Button Color="ButtonColors.Accent"
                                    IsFullWidth="true"
                                    IsDisabled="@_buyLoading"
                                    Text="@string.Format(GGModL10n.Get(GGModL10n.BuyNKeysFmt), _buyQty, GGModL10n.KeysText(_buyQty))"
                                    @onclick="BuyKeysAsync" />
                        </div>
                    }

                    <!-- REWARDS GRID (matches mobile .rewards-grid) -->
                    <div>
                        <span style="display:block;font-size:1.1rem;font-weight:700;color:#8a96a8;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:1rem;">@GGModL10n.Get(GGModL10n.ContentTitle)</span>
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(12rem,1fr));gap:1rem;">
                            @foreach (var r in _selectedCase.Rewards)
                            {
                                var oos = IsRewardOutOfStock(r);
                                <div class="gg-rcard @(oos ? "gg-rcard--oos" : "")" style="border-bottom:4px solid @r.Color;" @onclick="() => OpenRewardInfo(r)">
                                    @if (oos)
                                    {
                                        <div class="gg-rcard-oos">
                                            <Icon SVGIcon="Icons.Close" Size="IconSizes.Large" Style="color:rgba(255,255,255,0.85);width:3rem;height:3rem;" />
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(r.PictureUrl))
                                    {
                                        <img src="@r.PictureUrl" alt="@r.Name" class="gg-rcard-img" onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <div class="gg-rcard-icon">
                                            <Icon SVGIcon="@GetRewardIcon(r.RewardType)" Size="IconSizes.Large" Style="@($"color:{r.Color};width:3.4rem;height:3.4rem;")" />
                                        </div>
                                    }
                                    @if (_selectedCase.ShowRewardChance)
                                    {
                                        <div class="gg-rcard-chance">@r.Chance%</div>
                                    }
                                    @if (_selectedCase.ShowRewardName)
                                    {
                                        <div class="gg-rcard-name-bar">
                                            <span class="gg-rcard-name">@r.Name</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                </div>
            }
        }

    </div>

    <!-- HISTORY PANEL -->
    <div style="width:34rem;flex-shrink:0;border-left:1px solid rgba(255,255,255,0.08);display:flex;flex-direction:column;overflow:hidden;background:rgba(4,6,10,0.72);backdrop-filter:blur(1rem);">
        <div style="padding:1.6rem 1.6rem 1.2rem;flex-shrink:0;border-bottom:1px solid rgba(255,255,255,0.08);">
            <span style="font-size:1.6rem;font-weight:700;color:#FAFAFA;font-family:Rubik,sans-serif;">@GGModL10n.Get(GGModL10n.HistoryTitle)</span>
        </div>
        <div style="flex:1;overflow-y:auto;padding:0.8rem;" class="giz-scrollbar--v">
            @if (_historyLoading && _history.Count == 0)
            {
                <div style="display:flex;align-items:center;justify-content:center;height:10rem;">
                    <div class="gg-spinner"></div>
                </div>
            }
            else if (_history.Count == 0)
            {
                <div style="display:flex;align-items:center;justify-content:center;height:10rem;color:#3a4455;font-size:1.3rem;text-align:center;padding:2rem;">
                    @GGModL10n.Get(GGModL10n.NoHistory)
                </div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:0.5rem;">
                    @foreach (var h in _history)
                    {
                        <div class="gg-hist-item"
                             @onclick="() => OpenCaseFromHistoryAsync(h)"
                             style="display:flex;align-items:center;gap:1rem;padding:1rem 1.2rem;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-left:3px solid @(h.RewardColor);border-radius:1.2rem;">

                            <!-- Case thumbnail -->
                            <div style="width:4.8rem;height:4.8rem;border-radius:0.8rem;overflow:hidden;flex-shrink:0;background:rgba(10,14,20,0.9);position:relative;border:1px solid rgba(255,255,255,0.1);">
                                @if (!string.IsNullOrEmpty(h.CasePictureUrl))
                                {
                                    <img src="@h.CasePictureUrl" alt="@h.CaseName"
                                         style="width:100%;height:100%;object-fit:cover;"
                                         onerror="this.style.display='none'" />
                                }
                                else
                                {
                                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                                        <Icon SVGIcon="Icons.Star_Client" Size="IconSizes.Medium" Style="color:#6b7a8d;" />
                                    </div>
                                }
                            </div>

                            <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:0.4rem;">
                                <span style="font-size:1.2rem;font-weight:700;color:#d0d8e4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@h.CaseName</span>
                                <div style="display:flex;align-items:center;gap:0.6rem;">
                                    <div style="width:2.6rem;height:2.6rem;border-radius:0.5rem;overflow:hidden;flex-shrink:0;background:rgba(10,14,20,0.9);border:1px solid @(h.RewardColor)55;display:flex;align-items:center;justify-content:center;">
                                        @if (!string.IsNullOrEmpty(h.RewardPictureUrl))
                                        {
                                            <img src="@h.RewardPictureUrl" alt="@h.RewardName"
                                                 style="width:100%;height:100%;object-fit:cover;"
                                                 onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <Icon SVGIcon="@GetRewardIcon(h.RewardType)" Size="IconSizes.Small" Style="@($"color:{h.RewardColor};")" />
                                        }
                                    </div>
                                    <span style="font-size:1.05rem;font-weight:600;color:@h.RewardColor;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@h.RewardName</span>
                                </div>
                            </div>

                            <div style="flex-shrink:0;font-size:1rem;color:#4a5568;text-align:right;white-space:nowrap;">@FormatDate(h.Date)</div>
                        </div>
                    }

                    @if (HistoryHasMore)
                    {
                        <div style="padding:0.8rem;text-align:center;">
                            @if (_historyLoading)
                            {
                                <div style="display:flex;align-items:center;justify-content:center;padding:1rem;">
                                    <div class="gg-spinner" style="width:2.4rem;height:2.4rem;border-width:0.25rem;"></div>
                                </div>
                            }
                            else
                            {
                                <Button Variant="ButtonVariants.Outline"
                                        Size="ButtonSizes.Small"
                                        IsFullWidth="true"
                                        Text="@GGModL10n.Get(GGModL10n.LoadMore)"
                                        @onclick="LoadHistoryNextPageAsync" />
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

</div>

<!-- REWARD INFO MODAL -->
@if (_showRewardInfo && _rewardInfo is not null)
{
    <div @onclick="CloseRewardInfo"
         style="position:fixed;inset:0;z-index:9050;background:rgba(0,0,0,0.75);backdrop-filter:blur(0.8rem);display:flex;align-items:center;justify-content:center;cursor:pointer;">
        <div @onclick:stopPropagation="true"
             style="width:min(92vw,40rem);background:#141820;border-radius:2rem;overflow:hidden;box-shadow:0 2rem 6rem rgba(0,0,0,0.7);border:1px solid rgba(255,255,255,0.1);cursor:default;">

            <div style="display:flex;align-items:center;justify-content:space-between;padding:1.6rem 2rem;border-bottom:1px solid rgba(255,255,255,0.08);">
                <span style="font-size:1.6rem;font-weight:700;color:#FAFAFA;font-family:Rubik,sans-serif;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0;">
                    @(_selectedCase is not null && _selectedCase.ShowRewardName ? _rewardInfo.Name : GGModL10n.Get(GGModL10n.ContentTitle))
                </span>
                <IconButton SVGIcon="Icons.Close" Variant="ButtonVariants.Text" Size="ButtonSizes.Small" @onclick="CloseRewardInfo" />
            </div>

            <div style="padding:2rem;display:flex;flex-direction:column;align-items:center;gap:1.8rem;">

                <div style="width:16rem;height:16rem;border-radius:1.6rem;overflow:hidden;border:2px solid @_rewardInfo.Color;box-shadow:0 0 3rem @(_rewardInfo.Color)55;background:rgba(10,13,20,0.95);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    @if (!string.IsNullOrEmpty(_rewardInfo.PictureUrl))
                    {
                        <img src="@_rewardInfo.PictureUrl" alt="@_rewardInfo.Name"
                             style="width:100%;height:100%;object-fit:cover;"
                             onerror="this.style.display='none'" />
                    }
                    else
                    {
                        <Icon SVGIcon="@GetRewardIcon(_rewardInfo.RewardType)" Size="IconSizes.Large" Style="@($"color:{_rewardInfo.Color};width:5.8rem;height:5.8rem;")" />
                    }
                </div>

                @if (!string.IsNullOrEmpty(_rewardInfo.Description))
                {
                    <p style="font-size:1.35rem;color:rgba(255,255,255,0.55);text-align:center;margin:0;line-height:1.7;padding:0 0.4rem;">@_rewardInfo.Description</p>
                }

                <div style="width:100%;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:1.2rem;overflow:hidden;">
                    @if (_selectedCase is not null && _selectedCase.ShowRewardName)
                    {
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.4rem;border-bottom:1px solid rgba(255,255,255,0.06);">
                            <span style="font-size:1.3rem;color:rgba(255,255,255,0.4);">@GGModL10n.Get(GGModL10n.RewardNameLabel)</span>
                            <span style="font-size:1.3rem;font-weight:700;color:#FAFAFA;">@_rewardInfo.Name</span>
                        </div>
                    }
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.4rem;border-bottom:1px solid rgba(255,255,255,0.06);">
                        <span style="font-size:1.3rem;color:rgba(255,255,255,0.4);">@GGModL10n.Get(GGModL10n.RewardTypeLabel)</span>
                        <div style="display:flex;align-items:center;gap:0.6rem;">
                            <Icon SVGIcon="@GetRewardIcon(_rewardInfo.RewardType)" Size="IconSizes.Small" Style="@($"color:{_rewardInfo.Color};")" />
                            <span style="font-size:1.3rem;font-weight:700;color:@_rewardInfo.Color;">@GetRewardTypeName(_rewardInfo.RewardType)</span>
                        </div>
                    </div>
                    @if (_selectedCase is not null && _selectedCase.ShowRewardChance)
                    {
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.4rem;border-bottom:1px solid rgba(255,255,255,0.06);">
                            <span style="font-size:1.3rem;color:rgba(255,255,255,0.4);">@GGModL10n.Get(GGModL10n.ChanceLabel)</span>
                            <span style="font-size:1.3rem;font-weight:700;color:#4ecdc4;">@_rewardInfo.Chance%</span>
                        </div>
                    }
                </div>

                <Button Color="ButtonColors.Accent" IsFullWidth="true" Text="@GGModL10n.Get(GGModL10n.Close)" @onclick="CloseRewardInfo" />

            </div>
        </div>
    </div>
}

<!-- REWARD REVEAL OVERLAY -->
@if (_showRewardOverlay && _wonReward is not null)
{
    <div @onclick="CloseOverlay"
         style="position:fixed;inset:0;z-index:9100;background:rgba(0,0,0,0.9);backdrop-filter:blur(1.2rem);display:flex;align-items:center;justify-content:center;cursor:pointer;">
        <div class="gg-reveal" style="display:flex;flex-direction:column;align-items:center;gap:2.2rem;padding:3.2rem 2.4rem;text-align:center;pointer-events:none;">
            <div style="position:relative;width:20rem;height:20rem;display:flex;align-items:center;justify-content:center;">
                <div class="gg-ring-spin"
                     style="position:absolute;width:32rem;height:32rem;top:50%;left:50%;margin-top:-16rem;margin-left:-16rem;border-radius:50%;background:conic-gradient(from 0deg,transparent 0%,@_wonReward.Color 25%,transparent 55%);filter:blur(2.2rem);opacity:0.25;"></div>
                <div style="position:relative;width:20rem;height:20rem;border-radius:2rem;overflow:hidden;border:2px solid @_wonReward.Color;box-shadow:0 0 5rem @(_wonReward.Color)66;background:rgba(6,9,14,0.95);">
                    @if (!string.IsNullOrEmpty(_wonReward.PictureUrl))
                    {
                        <img src="@_wonReward.PictureUrl" alt="@_wonReward.Name"
                             style="width:100%;height:100%;object-fit:cover;"
                             onerror="this.style.display='none'" />
                        <div style="position:absolute;inset:0;background:rgba(0,0,0,0.2);"></div>
                    }
                    else
                    {
                        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                            <Icon SVGIcon="@GetRewardIcon(_wonReward.RewardType)" Size="IconSizes.Large" Style="@($"color:{_wonReward.Color};width:8rem;height:8rem;")" />
                        </div>
                    }
                    <div style="position:absolute;bottom:0;left:0;right:0;height:0.6rem;background:@_wonReward.Color;box-shadow:0 0 1.6rem @(_wonReward.Color)cc;"></div>
                </div>
            </div>
            @if (_selectedCase is not null && _selectedCase.ShowRewardName)
            {
                <span style="font-size:2.6rem;font-weight:700;color:#FAFAFA;font-family:Rubik,sans-serif;text-shadow:0 4px 20px rgba(0,0,0,0.8);">@_wonReward.Name</span>
            }
            <span style="font-size:1.2rem;color:rgba(255,255,255,0.5);display:flex;align-items:center;gap:0.7rem;">
                <Icon SVGIcon="Icons.Info_Client" Size="IconSizes.Small" Style="color:rgba(255,255,255,0.3);" />
                @GGModL10n.Get(GGModL10n.ClickToContinue)
            </span>
        </div>
    </div>
}
}
