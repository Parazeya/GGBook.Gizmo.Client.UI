@inherits CustomDOMComponentBase

<div class="gg-home">

    <div class="gg-home__hero">
        <div class="gg-home__quick-launch">
            <QuickLauncher />
        </div>
        @if (FeedsViewState.IsEnabled)
        {
            <div class="gg-home__news-rotator">
                <NewsRotator />
            </div>
        }
    </div>

    <div class="gg-home__feed giz-scrollbar--v">

        @if (AdvertisementsViewState.Advertisements.Count() > 0)
        {
            <div class="gg-home__section">
                <ExpansionPanel IsCollapsed="@AdvertisementsViewState.IsCollapsed" IsCollapsedChanged="@((value) => AdvertisementsViewStateService.SetCollapsed(value))">
                    <ExpansionPanelHeader>
                        @LocalizationService.GetString("GIZ_GEN_ADS")
                    </ExpansionPanelHeader>
                    <ChildContent>
                        <AdsCarousel Interval="5000" />
                    </ChildContent>
                </ExpansionPanel>
            </div>
        }

        @if (ViewState.IsShopEnabled && ViewState.PopularProducts.Any())
        {
            <div class="gg-home__section">
                <div class="gg-home__section-hd">
                    <span class="gg-home__section-title">@LocalizationService.GetString("GIZ_GEN_POPULAR_PRODUCTS")</span>
                </div>
                <ProductVirtualizedCards Items="ViewState.PopularProducts" ColumnsCount="ClientInterfaceOptions.Value.HomePageMaxItemsPerRow" />
            </div>
        }

        @if (ViewState.PopularApplications.Any())
        {
            <div class="gg-home__section">
                <div class="gg-home__section-hd">
                    <span class="gg-home__section-title">@LocalizationService.GetString("GIZ_GEN_POPULAR_APPS")</span>
                </div>
                <ApplicationVirtualizedCards Items="ViewState.PopularApplications" ColumnsCount="ClientInterfaceOptions.Value.HomePageMaxItemsPerRow" />
            </div>
        }

    </div>

</div>
